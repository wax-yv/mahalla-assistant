# ---------------------------------------------------------------------------
# Mahalla Assistant — environment template
# Copy to .env.local for local development. Never commit real values.
# On Vercel set these in Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0

# PostgreSQL. On Vercel use the pooled Neon/Vercel Postgres connection string.
DATABASE_URL=
POSTGRES_URL=

# Optional: extra psycopg connect timeout
# DATABASE_CONNECT_TIMEOUT=10

# Auth
AUTH_SECRET=change-me-to-a-long-random-string
# Admin hisobi. Qiymatlarni o'zingiz belgilang (bo'sh qoldirilsa, ilova
# `apps/api/app/core/config.py` dagi standart demo qiymatlaridan foydalanadi).
# ADMIN_USERNAME=your-admin-username
# ADMIN_PASSWORD=your-strong-password
SESSION_TTL_HOURS=72
SETUP_TOKEN=change-me
CRON_SECRET=change-me

# AI providers
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
AI_DEFAULT_PROVIDER=nvidia
AI_REQUEST_TIMEOUT=55
AI_DAILY_TOKEN_BUDGET=300000
AI_MAX_OUTPUT_TOKENS=1600
AI_TEMPERATURE=0.15
AI_MODEL_CONFIG_JSON=

# Storage. If BLOB_READ_WRITE_TOKEN is empty, files are stored in Postgres.
BLOB_READ_WRITE_TOKEN=
MAX_UPLOAD_MB=4

# Scheduler
SCHEDULER_TIMEZONE=Asia/Tashkent
DEMO_MODE=true

# Optional
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Frontend (apps/web) — set on the WEB Vercel project
# ---------------------------------------------------------------------------
# Public URL of the API project (no trailing slash).
# Local development defaults to http://127.0.0.1:8000.
API_ORIGIN=https://mahalla-assistant-api.vercel.app
